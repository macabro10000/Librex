/* Continuación de los estilos del modal de registro */
.modal-card input:focus {
    outline: none;
    border-color: #a78bfa;
    box-shadow: inset 0 2px 5px rgba(0,0,0,0.5), 0 0 12px rgba(167, 139, 250, 0.4);
}

.modal-card label {
    display: block;
    text-align: left;
    color: #c4b5fd;
    font-size: 12px;
    margin-top: 12px;
    margin-bottom: 4px;
    font-weight: 500;
}

.modal-card input[type="file"] {
    background: rgba(22, 20, 35, 0.9);
    padding: 10px;
    cursor: pointer;
    border: 1px dashed rgba(167, 139, 250, 0.4);
}

.modal-card button[type="submit"] {
    width: 100%;
    padding: 14px;
    margin-top: 20px;
    background: linear-gradient(135deg, #8b5cf6, #ec4899);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.4), 0 0 15px rgba(236, 72, 153, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.modal-card button[type="submit"]:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(139, 92, 246, 0.6), 0 0 20px rgba(236, 72, 153, 0.5);
}

.modal-card button[type="submit"]:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}
